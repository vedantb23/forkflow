# ---- Dependencies ----
# installed packages — huge, never commit, re-created by `npm install`
node_modules/

# ---- Secrets (NEVER commit these) ----
# backend secrets (DB url, API keys)
.env
# frontend secrets
.env.local
.env.*.local

# ---- Build output ----
# compiled backend JS (from TypeScript)
dist/
# Next.js build output
.next/
out/

# ---- Logs ----
*.log
npm-debug.log*

# ---- OS / editor junk ----
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
